{
  "expo": {
    "name": "Zwei Zuhause",
    "slug": "zwei-zuhause",
    "scheme": "zweizuhause",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F8F7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.zweizuhause.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F8F83",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "de.zweizuhause.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Damit du Belege zu Ausgaben hinzufügen kannst.",
          "cameraPermission": "Damit du Kassenbons und Belege fotografieren kannst."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F8F83"
        }
      ],
      "expo-font"
    ],
    "owner": "prepi26"
  }
}

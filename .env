# Supabase: Project Settings → API. Der anon/publishable Key ist öffentlich gedacht (Schutz über Row Level Security).
# NIEMALS den service_role/secret Key hier eintragen.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat (In-App-Abo „Wir zwei Plus“): Project Settings → API Keys → öffentliche App-Keys (appl_… / goog_…).
# Leer lassen = App läuft ohne Abo, Plus-Funktionen bleiben gesperrt.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Pflicht für Abos im App Store: öffentliche Links zu AGB und Datenschutzerklärung.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
